package-as: Name2Chat
enable-nolib-creation: yes
enable-toc-creation: yes

externals:
  libs/LibStub:
    url: https://github.com/WoWUIDev/Ace3
    path: LibStub
  libs/CallbackHandler-1.0:
    url: https://github.com/WoWUIDev/Ace3
    path: CallbackHandler-1.0
  libs/AceAddon-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceAddon-3.0
  libs/AceEvent-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceEvent-3.0
  libs/AceDB-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceDB-3.0
  libs/AceDBOptions-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceDBOptions-3.0
  libs/AceConsole-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceConsole-3.0
  libs/AceGUI-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceGUI-3.0
  libs/AceHook-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceHook-3.0
  libs/AceLocale-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceLocale-3.0
  libs/AceConfig-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceConfig-3.0

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .gitignore
  - .gitattributes
  - .luacheckrc
  - .pkgmeta
  - assets
  - scripts
  - CHANGELOG.md
  - README.md
  - LICENSE
